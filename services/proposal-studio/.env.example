# Secret API key required in the X-API-Key header for POST /api/decks and slide endpoints
STUDIO_API_KEY=change-me

# Target webhook URL for n8n/agent slide regeneration (optional, returns 503 if not set)
REGENERATE_WEBHOOK_URL=

# Optional secret key sent as X-API-Key header to the slide regeneration webhook
REGENERATE_WEBHOOK_KEY=

# Custom filesystem directory for saved deck projects (defaults to rfp-studio/saves)
SAVES_DIR=

# Groq Cloud API key for LLM agents (https://console.groq.com)
GROQ_API_KEY=

# Groq LLM model name (e.g. llama-3.3-70b-versatile, check Groq console for current models)
GROQ_MODEL=

# Groq OpenAI-compatible base URL (optional, only for testing or mock endpoints; defaults to https://api.groq.com/openai/v1)
GROQ_BASE_URL=

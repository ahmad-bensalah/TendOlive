templates/library/
templates/trash/
templates/settings.json
# Generation runs and tender trash (runtime)
generations/
tenders/trash/

# Agent system
agents/registry/
agents/.cache/

# Temporary files
saves/*.json
exports/*.pdf
exports/*.pptx
screenshots/*.png
dist/
__pycache__/
*.pyc

# Keep structure but ignore content
!saves/.gitkeep
!exports/.gitkeep
!screenshots/.gitkeep

# Except mock diagram images (needed for fixtures)
!uploads/mock_*.svg

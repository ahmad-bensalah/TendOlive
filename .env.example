# Copy to .env (never commit it), fill in, then: docker compose up -d
#
# Two private random strings (any long value). One command makes one, run it twice:
#   openssl rand -hex 24
#   (Windows PowerShell: -join ((48..57)+(97..102) | Get-Random -Count 48 | % {[char]$_}) )
STUDIO_API_KEY=
AGENTS_WEBHOOK_KEY=

# ---- The LLM: ONE setting for the whole system (our pipeline's Main AND the teammate's deck agents)
# groq (default) | gemini | openai | ollama      (anthropic is refused: the deck agents speak the OpenAI API only)
LLM_PROVIDER=groq
# Optional: another model than the provider's default
#   groq openai/gpt-oss-120b | gemini models/gemini-3.1-flash-lite | openai gpt-4.1-mini | ollama qwen3:4b-instruct
LLM_MODEL=
# Optional: another LLM for the deck agents only (empty = the same as Main). Example: Main on a local Ollama (no rate limit,
# private), the decks on Groq (fast): LLM_PROVIDER=ollama and DECK_LLM_PROVIDER=groq. Same choices as LLM_PROVIDER.
DECK_LLM_PROVIDER=
DECK_LLM_MODEL=
# The key of each provider you chose (Main's and the decks')
GROQ_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=
# LLM_PROVIDER=ollama: your Ollama server, seen from the n8n container (no key)
OLLAMA_URL=http://host.docker.internal:11434

# ---- Optional
# Firecrawl (https://firecrawl.dev): reads the real tender portals (URL sources) and the buyers' web pages.
# Empty = the URL sources are skipped; the BOAMP API source and everything else still run.
FIRECRAWL_KEY=
# true = Main reads ONLY the synthetic demo tenders (demo-tenders service): a demo always has fitting tenders
PIPELINE_DEMO_MODE=false
# auto (on when FIRECRAWL_KEY is set) | on | off
PIPELINE_URL_SOURCES=auto
# top1 = after a Main run, the studio starts the deck of the best tender | none = decks are started by hand
PIPELINE_AUTO_DECK=top1
# Pause between Main's LLM calls in ms (empty = by provider: ollama 0, groq 15000, gemini 4000, openai 1000). Free cloud tiers
# limit tokens per minute (Groq free: about 8 000), so Main is paced; a paid tier can use a smaller value.
PIPELINE_LLM_DELAY_MS=
GENERIC_TIMEZONE=Europe/Paris
# 1 = import and publish the workflows again at the next n8n start (replaces edits made to them in the n8n editor)
RFP_FORCE_IMPORT=0
